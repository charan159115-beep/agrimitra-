# Browser-safe Supabase settings (only needed for the existing auth/data features)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# SERVER ONLY - add this in Vercel Project Settings > Environment Variables.
# NEVER prefix it with VITE_ and NEVER commit the real value.
OPENAI_API_KEY=your_openai_api_key
